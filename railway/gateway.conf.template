# Gateway Railway: se configuran APP_HOST, AUTH_HOST, INVENTORY_HOST, SALES_HOST y REPORTS_HOST.
server {
    listen 80;
    server_name _;
    client_max_body_size 12m;
    location /api/auth/ {
        proxy_pass http://${AUTH_HOST}:8083;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
    }
    location /api/inventario/ {
        proxy_pass http://${INVENTORY_HOST}:8081;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
    }
    location /api/ventas {
        proxy_pass http://${SALES_HOST}:8082;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
    }
    # Ruta original Sanctum de Laravel: no se debe interceptar con JWT.
    location = /api/reportes/ventas {
        proxy_pass http://${APP_HOST}:8000;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location /api/reportes/ {
        proxy_pass http://${REPORTS_HOST}:8084;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
    }
    location / {
        proxy_pass http://${APP_HOST}:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
