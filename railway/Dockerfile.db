FROM mariadb:11.4
COPY railway/init-db.sh /docker-entrypoint-initdb.d/10-init-db.sh
COPY railway/db-schema.sql /docker-entrypoint-initdb.d/20-schema.sql
COPY railway/30-admin.sh /docker-entrypoint-initdb.d/30-admin.sh
RUN chmod 700 /docker-entrypoint-initdb.d/10-init-db.sh /docker-entrypoint-initdb.d/30-admin.sh
